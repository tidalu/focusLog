<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="#FF24243A">
    <TextView android:id="@+id/widget_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FocusLog" android:textStyle="bold" android:textColor="#FFFFFFFF" />
    <TextView android:id="@+id/widget_completion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="28sp" android:textStyle="bold" android:textColor="#FFE2E1FF" />
    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="#FFD6D4E8" android:maxLines="3" />
    <Button android:id="@+id/widget_add" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Add log" android:contentDescription="Add a FocusLog entry" />
</LinearLayout>
